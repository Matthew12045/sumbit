# Discord bot token (Developer Portal).  NEVER commit the real one.
DISCORD_TOKEN=
# Test guild id.
GUILD_ID=
# Voice channel the bot watches and joins.
VOICE_CHANNEL_ID=
# Text channel that receives the summary embed.
TARGET_CHANNEL_ID=

# Anthropic-compatible gateway base URL.  No trailing /v1 (the SDK appends /v1/messages).
ANTHROPIC_BASE_URL=https://gateway.9arm.co
# Gateway bearer token (Authorization: Bearer ...).
ANTHROPIC_AUTH_TOKEN=
# Gateway model id (must match the gateway's allowlist exactly).
# qwen3.8-27b-fp8: 128k-token context, quantized (faster); expect to wait
# through a long silent thinking phase before the response arrives.
GATEWAY_MODEL=qwen3.8-27b-fp8

# Local mlx-whisper model (Apple Silicon, Metal).
# whisper-large-v3-mlx (non-turbo) is far less prone to repetition-loop
# hallucinations on Thai; it is ~2-3x slower. For speed over robustness,
# switch back to mlx-community/whisper-large-v3-turbo.
WHISPER_MODEL=mlx-community/whisper-large-v3-mlx
# Source language for transcription.
WHISPER_LANGUAGE=th

# RMS speech threshold (0.01 ≈ -40 dBFS).
SILENCE_THRESHOLD=0.01
# Seconds of trailing silence that closes a chunk.
SILENCE_SECONDS=0.8
# Closed chunks shorter than this are dropped.
MIN_CHUNK_SECONDS=1.0
# Force-close cap for a continuous chunk.
MAX_CHUNK_SECONDS=30.0

# Anthropic SDK client timeout for summarization (seconds).  Larger input
# (MAX_PROMPT_CHARS) + output (SUMMARY_MAX_TOKENS) legitimately takes longer.
SUMMARIZE_TIMEOUT_SECONDS=300
# Maximum prompt characters sent to the gateway (truncated with suffix).
# The fp8 gateway model declares a 128k-token context window. Measured
# 2026-08-25 on qwen3.8-27b-fp8: prompt ≈1.23 chars/token — so 135k chars
# ≈110k tokens, leaving ~18k tokens of headroom for the system prompt and
# a full 8192-token output budget. Retune from tools/e2e_summarize_probe.py
# usage data if the gateway model changes.
MAX_PROMPT_CHARS=135000
# Maximum output tokens for the summarization call.  The richer schema
# (overview + per-item detail/rationale + open_questions) plus qwen's internal
# thinking needs this; too low and the model spends the whole budget reasoning
# and never emits a final text block (bot then posts an empty summary).
SUMMARY_MAX_TOKENS=8192
# Exact-repeat loop detection: a completed summary whose output (thinking +
# text) contains this many identical consecutive windows of
# REPETITION_WINDOW_CHARS chars is rejected and surfaces a ⚠️ note (qwen's
# thinking trace can loop instead of terminating).
REPETITION_WINDOW_CHARS=300
REPETITION_MIN_REPEATS=3

# Per-meeting RAG over the transcript (local MLX embeddings, no network at
# runtime). Chunks the transcript into overlapping line-aligned windows,
# retrieves the deduped union of top-k matches for a fixed set of Thai
# queries, and summarizes those excerpts. Set false to send the plain
# (truncated) full transcript instead.
RAG_ENABLED=true
# Local embedding model. First run downloads ~2 GB (bge-m3) into
# ~/.cache/huggingface.
EMBEDDING_MODEL=BAAI/bge-m3
# Top-k chunks retrieved per query (union across the fixed query set).
RAG_TOP_K=8
# Sliding-window chunk sizing over transcript lines (never splits a line;
# the overlap repeats trailing lines for context).
RAG_CHUNK_CHARS=800
RAG_OVERLAP_CHARS=150

# Polish (Thai-writing audit+fix loop, kien-thai skill)
# Set POLISH_ENABLED=true to activate.  Uses OpenAI-compatible API (OpenTyphoon).
# Safety cap: returns original summary if convergence not reached or on failure.
POLISH_ENABLED=false
POLISH_API_KEY=
POLISH_BASE_URL=https://api.opentyphoon.ai/v1
POLISH_MODEL=typhoon-v2.5-30b-a3b-instruct
POLISH_MAX_PASSES=20
POLISH_TIMEOUT_SECONDS=120

# NOTE: `members` is a PRIVILEGED intent — enable "Server Members Intent"
# in the Discord Developer Portal for your bot application, or the bot cannot
# resolve member display names.
# NOTE: macOS requires `brew install opus` for voice (py-cord ships libopus
# only as Windows DLLs).  First whisper run downloads ~3 GB (large-v3) into
# ~/.cache/huggingface; set HF_HOME only if the cache must live elsewhere.
# NOTE: optional runtime toggles (not Config keys — see CLAUDE.md):
#   DUMP_CHUNKS_DIR=<dir>          write each whisper chunk as a .wav for debugging
#   WHISPER_FP16=1                 whisper fp16 compute (default 1; must be set
#                                  before the first decode, restart to change)
#   WHISPER_RETRY_TEMPERATURE=0.2  anti-loop retry sampling temperature
#   WHISPER_INITIAL_PROMPT=        Thai preamble for the anti-loop retry
#                                  (empty value disables it)
#   WHISPER_BEAM_SIZE=0            beam-search width for whisper decoding
#                                  (>1 enables beam search, 0/1 = greedy).
#                                  Default is 0: the installed mlx-whisper
#                                  raises NotImplementedError for beam_size > 1
#                                  and best_of is incompatible with T=0 greedy
#                                  — flip only after upgrading mlx-whisper
