# Discord bot token (Developer Portal).  NEVER commit the real one.
DISCORD_TOKEN=
# Test guild id.
GUILD_ID=
# Voice channel the bot watches and joins.
VOICE_CHANNEL_ID=
# Text channel that receives the summary embed.
TARGET_CHANNEL_ID=
# Anthropic-compatible gateway base URL.  No trailing /v1 (the SDK appends /v1/messages).
ANTHROPIC_BASE_URL=https://gateway.9arm.co
# Gateway bearer token (Authorization: Bearer ...).
ANTHROPIC_AUTH_TOKEN=sk-...
# Gateway model id.
GATEWAY_MODEL=qwen3.6-35b-a3b
# Local mlx-whisper model (Apple Silicon, Metal).
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# Source language for transcription.
WHISPER_LANGUAGE=th
# RMS speech threshold (0.01 ≈ -40 dBFS).
SILENCE_THRESHOLD=0.01
# Seconds of trailing silence that closes a chunk.
SILENCE_SECONDS=0.8
# Closed chunks shorter than this are dropped.
MIN_CHUNK_SECONDS=1.0
# Force-close cap for a continuous chunk.
MAX_CHUNK_SECONDS=30.0
# Anthropic SDK client timeout for summarization (seconds).
SUMMARIZE_TIMEOUT_SECONDS=300
# Maximum prompt characters sent to the gateway (truncated with suffix).
MAX_PROMPT_CHARS=6000
# Maximum output tokens for the summarization call. qwen is a thinking model:
# it can spend its whole budget on internal reasoning and never emit a final
# text block (bot then posts an empty summary). Raise this if that happens.
SUMMARY_MAX_TOKENS=4096

# NOTE: `members` is a PRIVILEGED intent — enable "Server Members Intent"
# in the Discord Developer Portal for your bot application, or the bot cannot
# resolve member display names.
# NOTE: macOS requires `brew install opus` for voice (py-cord ships libopus
# only as Windows DLLs).  First whisper run downloads ~1.6 GB into
# ~/.cache/huggingface; set HF_HOME only if the cache must live elsewhere.
